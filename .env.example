# Copie este arquivo para .env e troque os valores.
# O .env fica fora do Git: segredo e configuração de ambiente nunca entram no repositório.

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-gerada

# True só em desenvolvimento. Em qualquer endereço público, False.
DEBUG=True

# Hosts separados por vírgula, sem espaço.
# Desenvolvimento: 127.0.0.1,localhost
# PythonAnywhere: usuario.pythonanywhere.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiáveis para POST, com esquema e porta, separadas por vírgula.
# Desenvolvimento: http://127.0.0.1:8000,http://localhost:8000
# PythonAnywhere: https://usuario.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
